{
  "name": "sayloud",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "prebuild": "pnpm build:wasm",
    "zip": "wxt zip",
    "prezip": "pnpm build:wasm",
    "build:wasm": "./scripts/build/build-phonemize-wasm.sh",
    "gen:headtts": "node scripts/generate/gen-headtts-rules.mjs",
    "gen:vocab": "node scripts/generate/gen-kokoro-vocab.mjs",
    "gen:pinyin": "node scripts/generate/gen-pinyin-pro-data.mjs",
    "gen:ja-ipa": "python3 scripts/generate/gen-ja-ipa-table.py",
    "check:headtts": "node scripts/generate/gen-headtts-rules.mjs --check",
    "check:vocab": "node scripts/generate/gen-kokoro-vocab.mjs --check",
    "check:manifest": "node scripts/check/check-manifest.mjs",
    "check:ja-mutations": "python3 scripts/check/mutation-check-ja.py",
    "build:e2e": "SAYLOUD_E2E=1 wxt build --mode e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:screenshots": "SAYLOUD_CAPTURE=1 playwright test tests/e2e/screenshots.spec.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "smoke:sidepanel": "node .smoke/sidepanel-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "postinstall": "wxt prepare && (./scripts/setup/setup-dictionaries.sh || echo '⚠️  Dictionaries were not built; the pipeline tests will fail. Re-run: FORCE=1 ./scripts/setup/setup-dictionaries.sh')"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "2.5.14",
    "@mozilla/readability": "0.6.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "5.0.2",
    "@wxt-dev/browser": "0.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.14.5",
    "msw": "^3.0.0",
    "patch-package": "^8.0.1",
    "pinyin-pro": "3.29.4",
    "preact": "10.29.8",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@piper-plus/g2p": "^0.4.2",
    "async": "^3.2.6",
    "kokoro-js": "1.2.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "path-browserify": "^1.0.1"
  }
}
