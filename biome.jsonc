{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    // `lib/vendor` holds third-party source kept close to upstream: kuromoji and
    // the kuroshiro analyzer that drives it, converted to ES modules. That
    // formatting is not ours to rewrite, and rewriting it would bury the next
    // upstream diff in churn.
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "!coverage", "!lib/vendor"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
