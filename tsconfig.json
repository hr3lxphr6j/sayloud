{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // The Chinese syllable table is generated data (`scripts/generate/gen-pinyin-table.py`)
    // and read by `scripts/generate/gen-pinyin-pro-data.mjs`; `resolveJsonModule` is here
    // for the corpus fixtures the parity tests import.
    "resolveJsonModule": true
  }
}
