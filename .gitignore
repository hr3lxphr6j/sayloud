.env.local
.superpowers/
.output/
.output-e2e/
test-results/
playwright-report/
coverage/
.wxt/
node_modules/
.idea/
.DS_Store

# The pi harness keeps its own state here.
.pi/
.ab-listen/

# Python bytecode from the vendored misaki transcription script.
__pycache__/
*.pyc

# The Japanese and Chinese dictionaries for the Rust phonemizer, built by
# scripts/setup/setup-lindera-dict.sh, scripts/setup/setup-jieba-dict.sh and
# scripts/setup/setup-wetext-fsts.sh on install. 8.5 MB of IPADic, 1.6 MB of jieba's
# word list and 707 KB of English text-normalization grammars, regenerated rather
# than tracked.
#
# The kuromoji dictionaries used to live here too, in `public/kuromoji-dict/`,
# for a JavaScript phonemize chain that is gone from the tree; the directory
# went with it.
public/dictionaries/

# POC and test scripts
poc/

# Rust build output, and the wasm-pack output that lib/models/phonemize-rust.ts
# imports. Both are build artifacts: `pnpm build` regenerates the latter through
# its `prebuild` hook. Anything that type-checks or tests the wrapper needs
# `pnpm build:wasm` to have run first.
/target/
lib/models/phonemize-wasm/
