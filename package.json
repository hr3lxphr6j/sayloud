{
  "name": "sayloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "SAYLOUD_E2E=1 wxt build --mode e2e",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:build": "pnpm build && vitest run --config vitest.build.config.ts",
    "smoke:sidepanel": "node .smoke/sidepanel-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "2.5.14",
    "@mozilla/readability": "0.6.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "5.0.2",
    "@wxt-dev/browser": "0.3.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.14.5",
    "msw": "^3.0.0",
    "preact": "10.29.8",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "phonemizer": "1.2.1",
    "pinyin-pro": "3.29.4"
  }
}
